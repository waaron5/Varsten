# Virtual environments
.venv

# Environment files
.env
.env.*
!.env.example

# Terraform — state and tfvars hold secrets (DB URL, Sentry DSN) in plaintext
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Committed, secret-free scaling inputs so CI and local share the same intended
# values (CI never sees the gitignored terraform.tfvars).
!infra/aws/terraform/scaling.auto.tfvars
.terraform.lock.hcl

