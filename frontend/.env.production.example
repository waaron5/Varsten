# Production dashboard environment (Vercel → Project Settings → Environment Variables,
# scope: Production). This file is an EXAMPLE — never commit real secrets.
#
# These must match the production backend, which validates Auth0 tokens for:
#   AUTH0_DOMAIN   = varsten.us.auth0.com
#   AUTH0_AUDIENCE = https://api.varsten.ai
#   CORS_ORIGINS   = ["https://app.varsten.ai"]   (browser calls are CORS-gated)

# --- Backend API the browser calls. NEXT_PUBLIC_* is inlined at BUILD time, so it
#     must be set in Vercel before the build runs. ---
NEXT_PUBLIC_API_BASE=https://xkmwbvcq2r.us-east-1.awsapprunner.com
# (switch to https://api.varsten.ai once the App Runner custom domain is configured)

# --- Auth0 (PRODUCTION tenant + the production "Regular Web Application") ---
AUTH0_DOMAIN=varsten.us.auth0.com
AUTH0_CLIENT_ID=<prod dashboard app client id>
AUTH0_CLIENT_SECRET=<prod dashboard app client secret>   # secret
AUTH0_SECRET=<openssl rand -hex 32>                       # secret, cookie encryption
AUTH0_AUDIENCE=https://api.varsten.ai
APP_BASE_URL=https://app.varsten.ai

# --- SECURITY GATE: do NOT set this in production. =1 disables auth (E2E bypass). ---
# NEXT_PUBLIC_E2E_AUTH_BYPASS=   # leave UNSET in prod

# Not needed in prod:
#   BASE_URL          -> only used by local playwright scripts
#   VARSTEN_API_KEY   -> only appears as text inside an onboarding code snippet
