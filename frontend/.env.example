NEXT_PUBLIC_API_BASE=http://localhost:8000

# Auth0 — create a "Regular Web Application" at https://manage.auth0.com
# Allowed Callback URL: http://localhost:3000/auth/callback
# Allowed Logout URL:   http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Create an Auth0 API; its Identifier is the audience the dashboard requests tokens for
AUTH0_AUDIENCE=https://api.varsten.local
APP_BASE_URL=http://localhost:3000
