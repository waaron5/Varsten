# Resend API key used by app/api/leads/route.ts.
RESEND_API_KEY=

# Founder/operator inbox that receives new lead notifications.
LEADS_NOTIFY_EMAIL=

# Verified Resend sender, e.g. Aaron Wood <aaron@varsten.ai>.
LEADS_FROM_EMAIL=

# 15-minute setup-call booking URL sent to buyers after lead capture.
LEADS_CALENDLY_URL=

# Where the "Start free" / trial / observe-only CTAs send buyers. Unset in
# prod (defaults to https://app.varsten.ai). Set to http://localhost:3000 for
# local testing against a locally running dashboard.
NEXT_PUBLIC_APP_URL=
