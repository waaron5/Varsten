# Resend API key used by app/api/leads/route.ts.
RESEND_API_KEY=

# Founder/operator inbox that receives new lead notifications.
LEADS_NOTIFY_EMAIL=

# Verified Resend sender, e.g. Aaron Wood <aaron@varsten.ai>.
LEADS_FROM_EMAIL=

# 15-minute setup-call booking URL sent to buyers after lead capture.
LEADS_CALENDLY_URL=

# Where the "Start free" / trial / Base CTAs send buyers. Unset in
# prod (defaults to https://app.varsten.ai). Set to http://localhost:3000 for
# local testing against a locally running dashboard.
NEXT_PUBLIC_APP_URL=

# Public site origin for canonicals, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://varsten.ai

# PostHog Cloud analytics. Leave empty locally unless testing analytics.
# The app sends only approved event names and sanitized event properties.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ANALYTICS_DEBUG=false
POSTHOG_DISABLED=false
