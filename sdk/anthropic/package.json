{
  "name": "@varsten/anthropic",
  "version": "0.1.0",
  "description": "Fail-open wrapper around the Anthropic SDK. Optimize through Varsten when it is healthy; fall back directly to Anthropic when Varsten is unavailable, so an outage costs you savings, not uptime.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Varsten, Inc.",
  "homepage": "https://varsten.ai/docs",
  "bugs": {
    "url": "https://github.com/waaron5/Varsten/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waaron5/Varsten.git",
    "directory": "sdk/anthropic"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "varsten",
    "anthropic",
    "claude",
    "llm",
    "fail-open",
    "fallback"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@varsten/core": "^0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.2",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
