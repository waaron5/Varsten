{
  "name": "@varsten/core",
  "version": "0.1.0",
  "description": "Provider-agnostic fail-open engine shared by Varsten's SDK wrappers: the fallback decision, the local circuit breaker, the error taxonomy, and best-effort telemetry. Not published standalone in v1.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["varsten", "llm", "fail-open", "fallback", "circuit-breaker"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
