DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
# Auth0 tenant for validating dashboard access tokens
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.varsten.local

# Founder/operator accounts allowed to use provisioning and validation tools.
# Must be a JSON array. Users not in this list receive 403 from /v1/operator/*.
OPERATOR_ADMIN_EMAILS='["aaron@varsten.ai"]'

# --- Inline proxy provider keys ---
# Default upstream provider for OpenAI-compatible SDK calls unless routing policy
# selects a different provider.
# PROXY_DEFAULT_PROVIDER=openai
# Local/dev key maps. Production should use PROVIDER_KEY_BACKEND=secretsmanager
# and write keys through PUT /v1/admin/connections/{provider}.
# PROXY_PROVIDER_KEYS='{"openai":{"<project-uuid>":"sk-..."},"anthropic":{"<project-uuid>":"sk-ant-..."},"gemini":{"<project-uuid>":"AIza-..."}}'
# Legacy OpenAI-only env map, retained for rollback/dev compatibility.
# PROXY_OPENAI_KEYS={"<project-uuid>":"sk-..."}
# PROXY_ANTHROPIC_KEYS={"<project-uuid>":"sk-ant-..."}
# PROXY_GEMINI_KEYS={"<project-uuid>":"AIza-..."}
# PROVIDER_KEY_BACKEND=env
# Self-serve key storage outside AWS: encrypt provider keys on the connection row.
# Set PROVIDER_KEY_BACKEND=localdb and a Fernet/base secret so the dashboard connect
# flow works without "manual setup required". Production still uses secretsmanager.
# PROVIDER_KEY_BACKEND=localdb
# PROVIDER_KEY_LOCAL_ENCRYPTION_KEY=
# PROVIDER_KEY_CACHE_TTL_SECONDS=30
# PROVIDER_KEY_CACHE_MAXSIZE=4096
# PROVIDER_KEY_SECRET_PREFIX=varsten
# PROVIDER_KEY_SECRET_ENVIRONMENT=development
# PROVIDER_KEY_AWS_REGION=us-east-1
# Required in production: ARN or ID of the dedicated customer-managed KMS key.
# PROVIDER_KEY_KMS_KEY_ID=arn:aws:kms:us-east-1:<account-id>:key/<key-id>
# To walk through onboarding locally with zero real provider account/spend, run
# `uv run python scripts/fake_provider.py` and point this at it instead:
# OPENAI_BASE_URL=http://127.0.0.1:9100
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Semantic cache (needs the pgvector extension on Postgres).
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# SEMANTIC_CACHE_THRESHOLD=0.08
# Max size of the client-supplied X-Varsten-Metadata JSON header (bytes). Larger
# payloads are ignored (fail-open), never an error.
# PROXY_METADATA_MAX_BYTES=8192
# Production latency mode for non-streaming miss-path proof writes. Runs
# ledger/evidence/cache capture detached from the response lifecycle.
# PROXY_CAPTURE_DETACHED=false
# PROXY_CAPTURE_DETACHED_MAX_CONCURRENCY=4
# PROXY_CAPTURE_DETACHED_QUEUE_SIZE=10000
# API_KEY_POSITIVE_CACHE_ENABLED=false
# API_KEY_CACHE_TTL_SECONDS=30
# PROXY_POLICY_CACHE_ENABLED=false
# Global kill switch: bypass all optimization, forward straight to OpenAI.
# PROXY_KILL_SWITCH=false
# Circuit breaker: fail fast after the upstream keeps failing, probe to recover.
# CIRCUIT_BREAKER_ENABLED=true
# CIRCUIT_BREAKER_FAIL_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_SECONDS=30
# Self-serve hardening. Validate a provider key (cheap probe) before storing it.
# PROVIDER_KEY_VALIDATION_ENABLED=true
# PROVIDER_KEY_VALIDATION_TIMEOUT_SECONDS=8
# Rate limits default to in-memory and are correct only at one API instance.
# RATE_LIMIT_ENABLED=true
# PROXY_RATE_LIMIT_PER_MINUTE=600
# CONNECT_RATE_LIMIT_PER_MINUTE=20
# Multi-instance coordination. Required before APP_MAX_INSTANCES > 1.
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.1

# --- Self-serve trial + billing ---
# 14-day Pro trial granted at signup; the sweep + lazy read downgrade an
# unpaid, elapsed trial to Base (traffic is never blocked).
# FREE_TRIAL_DAYS=14
# TRIAL_SWEEP_INTERVAL_SECONDS=3600
# Stripe self-serve upgrade (setup mode: collect a payment method; trial
# conversion happens at trial end). Off by default so the app boots without
# Stripe; turn on once keys are set. Webhook is signature-verified at /webhooks/stripe.
# SELF_SERVE_BILLING_ENABLED=false
# ALLOW_DISABLED_SELF_SERVE_BILLING=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_SUCCESS_URL=https://app.varsten.ai/admin/billing-security?checkout=success
# BILLING_CANCEL_URL=https://app.varsten.ai/admin/billing-security?checkout=cancel

# --- Observability ---
# LOG_LEVEL=INFO
# LOG_JSON=true
# Sentry error tracking; empty disables it.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
